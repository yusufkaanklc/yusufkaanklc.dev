# MongoDB connection string (with auth)
# Local: mongodb://user:password@localhost:27017/portfolio?authSource=admin
# Atlas: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/portfolio
MONGODB_URI=

# JWT secret key (generate with: openssl rand -base64 32)
JWT_SECRET=

# Admin password bcrypt hash (generate with: node -e "require('bcryptjs').hash('YOUR_PASSWORD',10).then(h=>console.log(h))")
ADMIN_PASSWORD_HASH=

SWAGGER_PASSWORD=